<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FindYourProperty | Find Your Dream Home</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navbar -->
<nav class="navbar navbar-expand-lg bg-white py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">
            <span class="brand-icon">⌂</span>
            FindYourProperty
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu"
                aria-controls="navbarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                <li class="nav-item">
                    <a class="nav-link active" href="/">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#properties">Properties</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#about">About</a>
                </li>

                <li class="nav-item">
    <a class="nav-link" href="/favourites">
        <i class="bi bi-heart-fill text-danger"></i>
        My Favourites
    </a>
</li>

                <li class="nav-item">
                    <a class="btn btn-dark px-4" href="#properties">
                        Explore Homes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="btn btn-success px-4"
                       href="/properties/new">
                        <i class="bi bi-plus-circle"></i>
                        Add Property
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
           


    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">

                <span class="hero-tag">
                    YOUR NEXT CHAPTER STARTS HERE
                </span>

                <h1>
                    Find a place<br>
                    you'll <span>love to live.</span>
                </h1>

                <p>
                    Discover properties that match your lifestyle,
                    preferences and budget.
                </p>
                
                <div class="col-md-4">
    <label class="form-label">Sort by price</label>

    <select name="sort" class="form-select">
        <option value="">Newest first</option>
        <option value="priceLow"
            <%= sort === "priceLow" ? "selected" : "" %>>
            Price: Low to High
        </option>
        <option value="priceHigh"
            <%= sort === "priceHigh" ? "selected" : "" %>>
            Price: High to Low
        </option>
    </select>
</div>

                <!-- Search Form -->
                <!-- Search and Filter Form -->
                <form action="/" method="GET" class="search-box row g-3">
                    <div class="col-md-4">
    <label for="propertyType" class="form-label">Property Type</label>

    <select name="propertyType" id="propertyType" class="form-select">
        <option value="">All Property Types</option>

        <option value="Apartment"
            <%= propertyType === "Apartment" ? "selected" : "" %>>
            Apartment
        </option>

        <option value="Independent House"
            <%= propertyType === "Independent House" ? "selected" : "" %>>
            Independent House
        </option>

        <option value="Villa"
            <%= propertyType === "Villa" ? "selected" : "" %>>
            Villa
        </option>

        <option value="Commercial Property"
            <%= propertyType === "Commercial Property" ? "selected" : "" %>>
            Commercial Property
        </option>
    </select>
</div>

                    <div class="col-12">
          <input
            type="text"
            name="q"
            placeholder="Search by location or property"
            class="form-control"
            aria-label="Search properties"
            value="<%= typeof q !== 'undefined' ? q : '' %>"
        >
    </div>

    <div class="col-md-4">
        <label class="form-label">Minimum budget (₹ lakh)</label>
        <input
            type="number"
            name="minPrice"
            class="form-control"
            min="0"
            placeholder="e.g. 20"
            value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>"
        >
    </div>

    <div class="col-md-4">
        <label class="form-label">Maximum budget (₹ lakh)</label>
        <input
            type="number"
            name="maxPrice"
            class="form-control"
            min="0"
            placeholder="e.g. 80"
            value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"
        >
    </div>

    <div class="col-md-4">
        <label class="form-label">Bedrooms</label>
        <select name="bedrooms" class="form-select">
            <option value="">Any bedrooms</option>
            <option value="1" <%= bedrooms == "1" ? "selected" : "" %>>1 BHK</option>
            <option value="2" <%= bedrooms == "2" ? "selected" : "" %>>2 BHK</option>
            <option value="3" <%= bedrooms == "3" ? "selected" : "" %>>3 BHK</option>
            <option value="4" <%= bedrooms == "4" ? "selected" : "" %>>4 BHK</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Sort by</label>
        <select name="sort" class="form-select">
            <option value="">Default</option>
            <option value="priceLow" <%= sort === "priceLow" ? "selected" : "" %>>Price: Low to High</option>
            <option value="priceHigh" <%= sort === "priceHigh" ? "selected" : "" %>>Price: High to Low</option>
        </select>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-dark">
            <i class="bi bi-search"></i> Search
        </button>

        <a href="/" class="btn btn-outline-secondary">
            Reset
        </a>
    </div>

</form>


                <!-- Hero Stats -->
                <div class="hero-stats">

                    <div>
                        <h4>100+</h4>
                        <small>Property choices</small>
                    </div>

                    <div>
                        <h4>50+</h4>
                        <small>Locations</small>
                    </div>

                    <div>
                        <h4>24/7</h4>
                        <small>Online access</small>
                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- Property Section -->
<section class="properties-section" id="properties">
    <div class="container">

        <div class="section-heading d-flex justify-content-between
             align-items-center flex-wrap gap-3">

            <div>
    <span class="section-tag">EXPLORE PROPERTIES</span>

    <h2>Homes you'll love</h2>

    <p>
        <% if (properties.length === 0) { %>
            No properties found. Try changing your search or filters.
        <% } else { %>
            Showing <strong><%= properties.length %></strong>
            <%= properties.length === 1 ? "property" : "properties" %>

            <% if (q) { %>
                matching "<strong><%= q %></strong>"
            <% } %>
        <% } %>
    </p>
</div>

            <a href="/properties/new" class="btn btn-success px-4">
                <i class="bi bi-plus-circle"></i>
                Add Property
            </a>

        </div>

        <!-- Property Cards -->
        <div class="row g-4">

            <% if (properties.length === 0) { %>
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="bi bi-house" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">No properties found</h4>
                        <p>Try another search or add a new property.</p>
                        <a href="/properties/new" class="btn btn-dark mt-2">
                            Add Your First Property
                        </a>
                    </div>
                </div>
            <% } %>

            <% properties.forEach(property => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="property-card">

                        <div class="property-image">
                            <img
                                src="<%= property.image %>"
                                alt="<%= property.title %>"
                                onerror="this.src='https://placehold.co/600x400?text=Property+Image'"
                            >
                            <span class="property-badge">Featured</span>
                        </div>

                        <div class="property-info">
                            <h5><%= property.title %></h5>

                            <p class="property-location">
                                <i class="bi bi-geo-alt"></i>
                                <%= property.location %>
                            </p>

                            <h4 class="property-price">
                                ₹<%= (Number(property.price) / 100000).toLocaleString("en-IN") %> Lakh
                            </h4>

                            <div class="property-details">
                                <span>
                                    <i class="bi bi-door-closed"></i>
                                    <%= property.bedrooms %> Beds
                                </span>

                                <span>
                                    <i class="bi bi-arrows-fullscreen"></i>
                                    <%= property.area %> sq.ft.
                                </span>
                            </div>

                            <div class="d-flex gap-2 mt-3">

    <a
        href="/properties/<%= property._id %>"
        class="btn btn-outline-dark flex-grow-1">
        <i class="bi bi-house"></i> View Details
    </a>

    <button
        type="button"
        class="btn btn-outline-danger favourite-btn"
        data-id="<%= property._id %>"
        data-title="<%= property.title %>"
        data-location="<%= property.location %>"
        data-price="<%= property.price %>"
        data-image="<%= property.image %>"
        aria-label="Add to favourites">
        <i class="bi bi-heart"></i>
    </button>

</div>
                        </div>

                    </div>
                </div>
            <% }) %>

        </div>
    </div>
</section>


    <!-- About Section -->
    <section class="about-section" id="about">
        <div class="container text-center">

            <span class="section-tag">
                ABOUT US
            </span>

            <h2>
                Finding your dream home, made simpler.
            </h2>

            <p>
                FindYourProperty helps you explore homes and
                discover the right space for your next chapter.
                AI-powered features are coming soon.
            </p>

        </div>
    </section>


    <!-- Footer -->
    <footer class="footer">
        <div class="container text-center">

            <h5>
                ⌂ FindYourProperty
            </h5>

            <p>
                Find a place you'll love to live.
            </p>

            <small>
                © 2026 FindYourProperty. Student project.
            </small>

        </div>
    </footer>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const buttons = document.querySelectorAll(".favourite-btn");

    function getFavourites() {
        try {
            return JSON.parse(localStorage.getItem("favourites") || "[]");
        } catch (error) {
            return [];
        }
    }

    function updateButton(button, isFavourite) {
        button.innerHTML = isFavourite
            ? '<i class="bi bi-heart-fill"></i>'
            : '<i class="bi bi-heart"></i>';

        button.classList.toggle("btn-danger", isFavourite);
        button.classList.toggle("btn-outline-danger", !isFavourite);
    }

    buttons.forEach(function (button) {

        const id = button.dataset.id;

        updateButton(
            button,
            getFavourites().some(function (property) {
                return property.id === id;
            })
        );

        button.addEventListener("click", function () {

            let favourites = getFavourites();

            const exists = favourites.some(function (property) {
                return property.id === id;
            });

            if (exists) {
                favourites = favourites.filter(function (property) {
                    return property.id !== id;
                });
            } else {
                favourites.push({
                    id: id,
                    title: button.dataset.title,
                    location: button.dataset.location,
                    price: button.dataset.price,
                    image: button.dataset.image
                });
            }

            localStorage.setItem("favourites", JSON.stringify(favourites));

            updateButton(button, !exists);
        });

    });

});
</script>

</body>
</html>