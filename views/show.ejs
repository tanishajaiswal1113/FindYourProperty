

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= property.title %> | FindYourProperty</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar bg-white">
        <div class="container py-2">
            <a class="navbar-brand fw-bold" href="/">
                <span class="brand-icon">⌂</span>
                FindYourProperty
            </a>

            <a href="/" class="btn btn-outline-dark">
                Back to Home
            </a>
        </div>
    </nav>

    <!-- Property Details -->
    <section class="container py-5">

        <a href="/" class="text-decoration-none text-secondary">
            ← Back to properties
        </a>

        <div class="mt-4">
            <img
    src="<%= property.image || 'https://placehold.co/900x500?text=Property+Image' %>"
    alt="<%= property.title %>"
    class="details-image"
    onerror="this.onerror=null; this.src='https://placehold.co/900x500?text=Property+Image';"
>
        </div>

        <div class="row mt-4 g-4">

            <!-- Main Details -->
            <div class="col-lg-8">
                <span class="tag">PROPERTY DETAILS</span>

                <h1 class="mt-2 fw-bold">
                    <%= property.title %>
                </h1>

                <p class="text-secondary fs-5">
                    <%= property.location %>
                </p>

                <h2 class="price mt-4">
                    ₹<%= (property.price / 100000).toLocaleString("en-IN") %> Lakh
                </h2>

                <hr>

                <h4 class="fw-bold mt-4">Overview</h4>

                <div class="row g-3 mt-2">
                    <div class="col-6 col-md-4">
                        <div class="detail-box">
                            <span>Bedrooms</span>
                            <h5><%= property.bedrooms %></h5>
                        </div>
                    </div>

                    <div class="col-6 col-md-4">
                        <div class="detail-box">
                            <span>Area</span>
                            <h5><%= property.area %> sq.ft.</h5>
                        </div>
                    </div>

                    <div class="col-6 col-md-4">
    <div class="detail-box">
        <span>Property Type</span>
        <h5>
            <i class="bi bi-building"></i>
            <%= property.propertyType || "Apartment" %>
        </h5>
    </div>
</div>
                </div>

                <h4 class="fw-bold mt-5">About this property</h4>

                <p class="text-secondary mt-3">
                    Explore this property in
                    <%= property.location %>.
                    This listing includes
                    <%= property.bedrooms %> bedrooms
                    and a total area of
                    <%= property.area %> square feet.
                    Contact the property owner for
                    further information.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-4">

    <a
        href="/properties/<%= property._id %>/edit"
        class="btn btn-dark"
    >
        <i class="bi bi-pencil-square"></i>
        Edit Property
    </a>

    <form
        action="/properties/<%= property._id %>/delete"
        method="POST"
        onsubmit="return confirm('Are you sure you want to delete this property? This action cannot be undone.');"
    >
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i>
            Delete Property
        </button>
    </form>

</div>

            <!-- Contact Card -->
            <div class="col-lg-4">
                <div class="contact-card">
                    <h4 class="fw-bold">Interested in this property?</h4>

                    <p class="text-secondary">
                        Contact the property owner for more details.
                    </p>

                    <button class="btn btn-dark w-100" disabled>
                        Contact owner (Coming soon)
                    </button>

                    <p class="text-secondary small mt-3 mb-0">
                        Property information is sample data
                        for this project.
                    </p>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer class="footer text-center">
        <div class="container">
            <h5>⌂ FindYourProperty</h5>
            <p>Find a place you'll love to live.</p>
            <small>© 2026 FindYourProperty</small>
        </div>
    </footer>

</body>
</html>